<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /layanan-layak-anak/

    # Blokir akses langsung ke folder sensitif
    RewriteRule ^(application|system|database)/ - [F,L]

    # Lewati file & folder yang benar-benar ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 /layanan-layak-anak/index.php
</IfModule>
